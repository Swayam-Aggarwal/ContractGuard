# Application
NODE_ENV=development
PORT=5000
APP_ORIGIN=http://localhost:5173

# Development database
MONGODB_URI=mongodb://127.0.0.1:27017/contractguard

# Separate integration-test database
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/contractguard_test

# Authentication
# Generate a unique 48-byte Base64URL secret for a new environment.
JWT_SECRET=
JWT_EXPIRES_IN=30m

# Optional AI integration
# Keep the Gemini API key server-side in the root .env file.
# Never put this key in client-side environment variables or source control.
#
# Use a Google AI Studio project on the Free tier with no billing attached.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash